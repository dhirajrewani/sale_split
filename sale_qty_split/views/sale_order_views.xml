<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_qty_split" model="ir.ui.view">
        <field name="name">sale.order.form.qty.split</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Order-level banner with a split button -->
            <xpath expr="//sheet" position="before">
                <field name="has_qty_split_violation" invisible="1"/>
                <div class="alert alert-warning d-flex align-items-center justify-content-between mb-0"
                     role="alert"
                     invisible="not has_qty_split_violation or state not in ('draft', 'sent')">
                    <span>Some lines exceed the maximum quantity allowed per order. This order cannot be confirmed as is.</span>
                    <button name="action_split_over_limit" type="object"
                            class="btn btn-primary ms-3" string="Split Over-Limit Lines"/>
                </div>
            </xpath>
            <!-- Per-line OWL widget -->
            <xpath expr="//list[@name='sol_list']/column[@name='sol_qty']" position="after">
                <field name="qty_split_limit" column_invisible="True"/>
                <field name="qty_over_limit" widget="qty_split_widget" string=" " width="20px"
                       readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
