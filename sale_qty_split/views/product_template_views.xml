<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_qty_split" model="ir.ui.view">
        <field name="name">product.template.form.qty.split</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="qty_order_split"
                       invisible="not sale_ok"
                       help="Max quantity of this product per sale order. 0 = no limit."/>
            </xpath>
        </field>
    </record>
</odoo>
